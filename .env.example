# =============================================================================
# Lead Agent — environment configuration
# Copy this file to .env and adjust. Nothing here should ever be hardcoded
# in Python — see app/core/config.py.
# =============================================================================

# --- App ---
APP_NAME=lead-agent
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Data source -------------------------------------------------------------
# "prototype"    -> in-memory, seeded fake data (sprint 1, no external calls)
# "google_sheet" -> real Google Sheets via gspread (sprint 2+)
DATA_SOURCE_MODE=google_sheet

GOOGLE_SHEET_ID=1335qIOFetGY9AMT3s8yyCOYspqMw7SbP3_MZAJ2Lzjo
GOOGLE_SHEET_WORKSHEET_NAME=Leads
# Path to the service account JSON key (see README > Google Sheets setup)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./credentials/service_account.json

# --- LLM ----------------------------------------------------------------------
# "ollama"     -> local, free, recommended for the Lead Agent (high frequency)
# "openrouter" -> hosted, pay-per-token, use only if you need a stronger model
LLM_PROVIDER=ollama
LLM_MODEL_NAME=qwen3:8b
LLM_TIMEOUT_SECONDS=20

OLLAMA_BASE_URL=http://localhost:11434

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Business rules thresholds (all retunable without touching code) ---------
LEAD_HOT_RESPONSE_HOURS=2.0
PAYMENT_OVERDUE_DAYS=3
FOLLOW_UP_OFFSET_DAYS=1
DUPLICATE_CHECK_ENABLED=true

PRIORITY_P0_SCORE_THRESHOLD=75.0
PRIORITY_P1_SCORE_THRESHOLD=40.0

# --- Budget guardrail ----------------------------------------------------------
# Hard ceiling on LLM calls/hour. If a bug loops, this stops it before it
# becomes a surprise bill instead of stopping the agent from working at all.
LLM_MAX_CALLS_PER_HOUR=50

# --- Automation (n8n) ----------------------------------------------------------
# Leave empty in sprint 1 — trigger_*() calls will just log instead of POSTing.
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
AUTOMATION_ENABLED=true

# --- Existing Task Manager ---------------------------------------------------
# Optional until its task API contract and authentication have been agreed.
TASK_MANAGER_API_BASE_URL=
# Shared server-to-server secret. Give it only to the Hub backend, never to a browser.
HUB_INTEGRATION_SECRET=

# Folder containing approved internal Markdown documents for the local RAG layer.
KNOWLEDGE_BASE_DIR=app/data
